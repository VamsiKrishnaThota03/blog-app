# Copy to server/.env and fill in real values. Never commit the real file.
PORT=4000
# PostgreSQL connection string, e.g. from Neon: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blog
# Long random string used to sign JWTs, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
# Optional: comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Optional: disable | no-verify (default: verified TLS, off for localhost)
DB_SSL=
# Only for `npm run seed`
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=
